import { createFileRoute } from "@tanstack/react-router";
import { useEffect, useState } from "react";
import { fetchVisitorsAll, type VisitorDetailed } from "@/services/supabase/community";
import { Search, Download, Filter } from "lucide-react";
import { Badge, Card, DashboardLayout } from "@/components/dashboard/DashboardLayout";
import { securityNav } from "@/components/dashboard/securityNav";
import { PageHeader } from "@/components/dashboard/PageHeader";

export const Route = createFileRoute("/dashboard/security/visitor-logs")({
  head: () => ({ meta: [{ title: "Visitor Logs — Communa Security" }] }),
  component: VisitorLogs,
});

function VisitorLogs() {
  const [visitors, setVisitors] = useState<VisitorDetailed[]>([]);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("All");

  useEffect(() => {
    fetchVisitorsAll().then(setVisitors);
  }, []);

  const filtered = visitors.filter((v) => {
    const s = search.toLowerCase();
    const matchSearch =
      v.name.toLowerCase().includes(s) ||
      v.flat.toLowerCase().includes(s) ||
      v.vehicle?.toLowerCase().includes(s) ||
      v.purpose.toLowerCase().includes(s);

    const matchStatus = statusFilter === "All" || v.status === statusFilter.toLowerCase().replace(" ", "_");
    
    return matchSearch && matchStatus;
  });

  return (
    <DashboardLayout role="Security" items={securityNav}>
      <div className="space-y-6 animate-fade-up">
        <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <PageHeader title="Visitor Logs" subtitle="Complete history of all gate entries and exits." />
          <div className="flex items-center gap-2">
            <button className="inline-flex h-10 px-4 items-center rounded-lg bg-foreground/5 hover:bg-foreground/10 text-sm font-medium gap-2 transition">
              <Download className="h-4 w-4" /> Export CSV
            </button>
          </div>
        </div>

        <Card>
          <div className="flex flex-col sm:flex-row gap-4 mb-6">
            <div className="relative flex-1">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
              <input
                type="text"
                placeholder="Search visitors, flats, vehicles..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                className="w-full h-10 pl-9 pr-3 text-sm rounded-lg bg-foreground/5 border border-transparent focus:bg-background focus:border-input focus:outline-none focus:ring-2 focus:ring-ring transition"
              />
            </div>
            <div className="flex gap-2">
              <div className="relative">
                <Filter className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                <select
                  value={statusFilter}
                  onChange={(e) => setStatusFilter(e.target.value)}
                  className="h-10 pl-9 pr-8 text-sm rounded-lg bg-foreground/5 border border-transparent focus:bg-background focus:border-input focus:outline-none focus:ring-2 focus:ring-ring transition appearance-none"
                >
                  <option>All</option>
                  <option>Pending</option>
                  <option>Approved</option>
                  <option>Checked In</option>
                  <option>Checked Out</option>
                  <option>Rejected</option>
                </select>
              </div>
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-sm text-left">
              <thead>
                <tr className="border-b border-border text-muted-foreground">
                  <th className="px-4 py-3 font-medium">Date</th>
                  <th className="px-4 py-3 font-medium">Visitor Name</th>
                  <th className="px-4 py-3 font-medium">Host / Flat</th>
                  <th className="px-4 py-3 font-medium">Purpose</th>
                  <th className="px-4 py-3 font-medium">Status</th>
                  <th className="px-4 py-3 font-medium">Check In</th>
                  <th className="px-4 py-3 font-medium">Check Out</th>
                  <th className="px-4 py-3 font-medium">Vehicle</th>
                </tr>
              </thead>
              <tbody>
                {filtered.map((v) => (
                  <tr key={v.id} className="border-b border-border/50 hover:bg-foreground/[0.02]">
                    <td className="px-4 py-4 whitespace-nowrap">{v.date}</td>
                    <td className="px-4 py-4 font-medium">
                      {v.name}
                      <div className="text-xs text-muted-foreground font-normal mt-0.5">
                        {v.phone}
                      </div>
                    </td>
                    <td className="px-4 py-4">
                      {v.flat}
                      <div className="text-xs text-muted-foreground mt-0.5">{v.host}</div>
                    </td>
                    <td className="px-4 py-4 text-foreground/80">{v.purpose}</td>
                    <td className="px-4 py-4">
                      <Badge tone={
                        v.status === 'pending' ? 'warning' :
                        v.status === 'approved' ? 'accent' :
                        v.status === 'checked_in' ? 'primary' :
                        v.status === 'rejected' ? 'danger' : 'muted'
                      }>
                        {v.status.replace('_', ' ').replace(/\\b\\w/g, l => l.toUpperCase())}
                      </Badge>
                    </td>
                    <td className="px-4 py-4 text-foreground/80">{v.checkIn || "—"}</td>
                    <td className="px-4 py-4 text-foreground/80">{v.checkOut || "—"}</td>
                    <td className="px-4 py-4 text-foreground/80">{v.vehicle || "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            
            {filtered.length === 0 && (
              <div className="py-12 text-center text-muted-foreground">
                No visitors found matching your filters.
              </div>
            )}
          </div>
        </Card>
      </div>
    </DashboardLayout>
  );
}
